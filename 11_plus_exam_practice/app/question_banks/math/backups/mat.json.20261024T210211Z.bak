  {
    "question_id": "math-8c68b6fe958e3741",
    "question": "Equation : “x+27=71",
    "questiontopic": "Unclassified",
    "answer": "",
    "explanation": ""
  },
  {
    "question_id": "math-6649056402f48f4d",
    "question": "Undo the + 27 by subtracting 27. Remember, you need to do it to BOTH sides!\nThis gives: x+27-27= 71-27",
    "questiontopic": "Unclassified",
    "answer": "",
    "explanation": ""
  },
  {
    "question_id": "math-9aec6ead392af715",
    "question": "Answer: x= 44",
    "questiontopic": "Unclassified",
    "answer": "",
    "explanation": ""
  },
  {
    "question_id": "math-24bc94908b2987e5",
    "question": "Equation : 3y + 34 = 2y + 89",
    "questiontopic": "Unclassified",
    "answer": "",
    "explanation": ""
  },
  {
    "question_id": "math-8b7e21a0864b17f6",
    "question": "Undo the + 34 by subtracting 34 from both sides.\nThis gives: 3y + 34-34 = 2y + 89 - 34\nSimplifying:  3y = 2y + 55",
    "questiontopic": "Unclassified",
    "answer": "",
    "explanation": ""
  },
  {
    "question_id": "math-b3fc96f77c41694c",
    "question": "Now subtract 2y from both sides to get rid of the variable on the right hand\nside.",
    "questiontopic": "Unclassified",
    "answer": "",
    "explanation": ""
  },
  {
    "question_id": "math-750c807cf15ee8f8",
    "question": "This gives: 3y — 2y = 2y - 2y + 55",
    "questiontopic": "Unclassified",
    "answer": "",
    "explanation": ""
  },
  {
    "question_id": "math-09508b906d63f1a0",
    "question": "Answer: y = 55",
    "questiontopic": "Unclassified",
    "answer": "",
    "explanation": ""
  },
  {
    "question_id": "math-ac5e2fd23bfd2cac",
    "question": "We can check this is correct by placing y = 55 in the original equation.\nLHS = 3y + 34 = 3(55) + 34 = 165 + 34 = 199",
    "questiontopic": "Unclassified",
    "answer": "",
    "explanation": ""
  },
  {
    "question_id": "math-3e2a15a43e95e02b",
    "question": "RHS = 2y + 89 = 2(55) + 89 = 110 + 89 = 199",
    "questiontopic": "Unclassified",
    "answer": "",
    "explanation": ""
  },
  {
    "question_id": "math-07e900ee5572d998",
    "question": "Page 6 of 10",
    "questiontopic": "Unclassified",
    "answer": "",
